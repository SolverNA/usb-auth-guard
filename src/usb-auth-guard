#!/usr/bin/env python3
"""
usb-auth-guard — USB device authorization daemon for KDE/Linux
Uses polkit (pkexec) for native KDE password dialog.

https://github.com/SolVerNA/usb-auth-guard
License: MIT
"""

import dbus
import dbus.mainloop.glib
from gi.repository import GLib
import subprocess
import os
import sys
import time
import logging
import re

logging.basicConfig(
    level=logging.INFO,
    format='[usb-auth-guard] %(levelname)s %(message)s'
)
log = logging.getLogger(__name__)

CURRENT_USER = os.environ.get('USER') or os.environ.get('LOGNAME', 'root')

HELPER_POLKIT  = '/usr/local/lib/usb-auth-guard/helper'
HELPER_TRUSTED = '/usr/local/lib/usb-auth-guard/helper-trusted'

# After a successful auth, re-insertions are auto-allowed via sudo NOPASSWD (no
# popup) for a short window, so devices that re-enumerate don't nag the user.
#
# Two independent windows, checked with OR:
#   VID:PID (60s) — iPhones etc. re-enumerate several times keeping the same id.
#   Port    (5s)  — firmware flashing makes a device drop and reappear on the
#     SAME physical port while CHANGING its VID:PID (bootloader/DFU/app modes),
#     so the VID:PID window never matches. Keyed on the physical port path
#     (via-port) instead. Kept deliberately short: trusting a socket means
#     ANYTHING plugged there is allowed, so we only want to bridge the
#     sub-second re-enumeration gap — not a window long enough to pull the real
#     device and swap in a BadUSB on the same port.
TRUST_WINDOW_SECONDS      = 60
PORT_TRUST_WINDOW_SECONDS = 5

# {vid_pid: last_authorized_timestamp} and {via_port: last_authorized_timestamp}
_trust_window: dict[str, float] = {}
_port_trust_window: dict[str, float] = {}


def get_env():
    env = os.environ.copy()
    for var in ('DISPLAY', 'XAUTHORITY', 'DBUS_SESSION_BUS_ADDRESS',
                'XDG_RUNTIME_DIR', 'KDE_FULL_SESSION'):
        val = os.environ.get(var)
        if val:
            env[var] = val
    return env


def allow_device_via_polkit(device_id: int, device_name: str) -> bool:
    try:
        result = subprocess.run(
            [
                'pkexec',
                '--disable-internal-agent',
                HELPER_POLKIT,
                str(device_id)
            ],
            capture_output=True,
            text=True,
            timeout=60,
            env=get_env()
        )
        if result.returncode == 0:
            log.info('Device %d "%s" allowed via polkit', device_id, device_name)
            return True
        else:
            log.info('Device %d denied or cancelled (pkexec exit=%d)',
                     device_id, result.returncode)
            return False
    except subprocess.TimeoutExpired:
        log.warning('Polkit dialog timed out for device %d', device_id)
        return False
    except Exception as e:
        log.error('pkexec error: %s', e)
        return False


def allow_device_via_sudo(device_id: int, device_name: str) -> bool:
    """Fast path for devices already authorized in the trust window."""
    try:
        result = subprocess.run(
            ['sudo', '-n', HELPER_TRUSTED, str(device_id)],
            capture_output=True,
            text=True,
            timeout=10,
        )
        if result.returncode == 0:
            log.info('Device %d "%s" auto-allowed (trust window)', device_id, device_name)
            return True
        log.warning('Trusted helper failed for device %d (exit=%d): %s',
                    device_id, result.returncode, result.stderr.strip())
        return False
    except subprocess.TimeoutExpired:
        log.warning('Trusted helper timed out for device %d', device_id)
        return False
    except Exception as e:
        log.error('sudo helper-trusted error: %s', e)
        return False


def parse_device_name(device_rule: str) -> str:
    m = re.search(r'name\s+"([^"]+)"', str(device_rule))
    if m and m.group(1).strip():
        return m.group(1)
    m = re.search(r'\bid\s+([0-9a-fA-F]{4}:[0-9a-fA-F]{4})\b', str(device_rule))
    if m:
        return f'USB Device {m.group(1)}'
    return 'Unknown USB Device'


def parse_vid_pid(device_rule: str) -> str | None:
    m = re.search(r'\bid\s+([0-9a-fA-F]{4}:[0-9a-fA-F]{4})\b', str(device_rule))
    return m.group(1).lower() if m else None


def parse_via_port(device_rule: str) -> str | None:
    """Physical USB port path (e.g. '3-1.2'). Stable across re-enumeration on
    the same socket, even when the device changes VID:PID between modes."""
    m = re.search(r'\bvia-port\s+"([^"]+)"', str(device_rule))
    return m.group(1) if m else None


def is_recently_trusted(store: dict[str, float], key: str | None, window: float) -> bool:
    if key is None:
        return False
    ts = store.get(key)
    if ts is None:
        return False
    if time.monotonic() - ts > window:
        del store[key]
        return False
    return True


def mark_trusted(store: dict[str, float], key: str | None) -> None:
    if key is not None:
        store[key] = time.monotonic()


def on_device_presence_changed(device_id, event_type, target, device_rule, *args):
    INSERT = 1
    BLOCK  = 1

    if int(event_type) != INSERT:
        return
    if int(target) != BLOCK:
        return

    dev_id = int(device_id)
    device_name = parse_device_name(device_rule)
    vid_pid = parse_vid_pid(device_rule)
    via_port = parse_via_port(device_rule)

    trusted_vid  = is_recently_trusted(_trust_window, vid_pid, TRUST_WINDOW_SECONDS)
    trusted_port = is_recently_trusted(_port_trust_window, via_port, PORT_TRUST_WINDOW_SECONDS)

    if trusted_vid or trusted_port:
        reason = 'vid:pid' if trusted_vid else 'port'
        log.info('Blocked device id=%d name="%s" vid:pid=%s port=%s — within %s trust window',
                 dev_id, device_name, vid_pid, via_port, reason)
        if allow_device_via_sudo(dev_id, device_name):
            # Refresh both windows so a chain of re-enumerations keeps flowing.
            mark_trusted(_trust_window, vid_pid)
            mark_trusted(_port_trust_window, via_port)
            return
        log.info('Falling back to polkit prompt for device %d', dev_id)

    log.info('New blocked device: id=%d name="%s"', dev_id, device_name)
    if allow_device_via_polkit(dev_id, device_name):
        mark_trusted(_trust_window, vid_pid)
        mark_trusted(_port_trust_window, via_port)


def main():
    log.info('Starting usb-auth-guard (polkit mode) for user %s', CURRENT_USER)

    dbus.mainloop.glib.DBusGMainLoop(set_as_default=True)

    try:
        bus = dbus.SystemBus()
        bus.get_name_owner('org.usbguard1')
    except dbus.DBusException as e:
        log.error('Cannot connect to USBGuard D-Bus: %s', e)
        log.error('Run: sudo systemctl start usbguard-dbus')
        sys.exit(1)

    state = {'iface': None, 'match': None}

    def subscribe():
        # Drop any stale signal match from a previous owner before adding a new
        # one. connect_to_signal() installs a match rule that survives the old
        # owner's disappearance; without removing it, rules accumulate on every
        # usbguard-dbus restart (and could double-fire depending on dbus-python).
        if state['match'] is not None:
            try:
                state['match'].remove()
            except Exception:
                pass
            state['match'] = None
        proxy = bus.get_object('org.usbguard1', '/org/usbguard1/Devices')
        iface = dbus.Interface(proxy, dbus_interface='org.usbguard.Devices1')
        state['match'] = iface.connect_to_signal(
            'DevicePresenceChanged', on_device_presence_changed)
        state['iface'] = iface
        log.info('Listening for USBGuard events...')

    try:
        subscribe()
    except dbus.DBusException as e:
        log.error('Cannot subscribe to USBGuard D-Bus signals: %s', e)
        sys.exit(1)

    # Re-subscribe automatically when usbguard-dbus restarts.
    # Each restart gives the process a new unique D-Bus name; without re-subscribing
    # the old match rule is stale and DevicePresenceChanged signals are never received.
    def on_usbguard_name_changed(new_owner):
        if new_owner and state['iface'] is None:
            log.info('USBGuard D-Bus reappeared, re-subscribing...')
            try:
                subscribe()
            except dbus.DBusException as e:
                log.error('Re-subscribe failed: %s', e)
        elif not new_owner and state['iface'] is not None:
            log.warning('USBGuard D-Bus disappeared, waiting for restart...')
            state['iface'] = None

    # watch_name_owner fires immediately with the current owner; because
    # subscribe() above already populated state['iface'], the
    # "new_owner and iface is None" branch is skipped for that initial call.
    bus.watch_name_owner('org.usbguard1', on_usbguard_name_changed)

    loop = GLib.MainLoop()
    try:
        loop.run()
    except KeyboardInterrupt:
        log.info('Stopped.')


if __name__ == '__main__':
    main()
