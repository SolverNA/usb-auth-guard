#!/usr/bin/env python3
"""
usb-auth-guard — USB device authorization daemon for KDE/Linux
Uses polkit (pkexec) for native KDE password dialog.

https://github.com/SolVerNA/usb-auth-guard
License: MIT
"""

import dbus
import dbus.mainloop.glib
from gi.repository import GLib
import subprocess
import os
import sys
import threading
import time
import logging
import re

logging.basicConfig(
    level=logging.INFO,
    format='[usb-auth-guard] %(levelname)s %(message)s'
)
log = logging.getLogger(__name__)

CURRENT_USER = os.environ.get('USER') or os.environ.get('LOGNAME', 'root')

HELPER_POLKIT  = '/usr/local/lib/usb-auth-guard/helper'
HELPER_TRUSTED = '/usr/local/lib/usb-auth-guard/helper-trusted'

# After a device is authorized, a re-insertion is allowed without a popup for a
# short grace period — but the clock starts when the device is UNPLUGGED and
# measures the remove→re-insert gap. Starting it at auth time would be wrong: a
# device can sit plugged in through a long flash and only re-enumerate at the
# very end, by which point an auth-time window would have long expired.
#
# Two independent windows, checked with OR on insert:
#   VID:PID (60s) — same id re-inserted on ANY port (unplug/replug a stick,
#     iPhone switching modes). A spoofed VID:PID within 60s of removal also
#     passes — documented convenience/security trade-off.
#   Port (5s) — SAME physical port (via-port), for firmware flashing where the
#     device reappears on the same socket with a DIFFERENT VID:PID
#     (bootloader/DFU/app). Short on purpose: trusting a socket auto-allows
#     anything plugged there, so 5s only bridges the re-enumeration gap — not
#     long enough to pull the device and swap in a BadUSB on the same port.
TRUST_WINDOW_SECONDS      = 60
PORT_TRUST_WINDOW_SECONDS = 5

# After the user denies/cancels a prompt for a device identity, further inserts
# of that identity stay blocked without a new dialog for this long. Devices that
# re-enumerate rapidly (an iPhone switching modes, a board being flashed) would
# otherwise fire one pkexec per new device id; overlapping dialogs auto-fail
# their PAM conversation, and every such failure counts toward pam_faillock —
# three of them lock the user's account for sudo and console login too.
DENIAL_COOLDOWN_SECONDS = 45

# Identities authorized this session. A window is armed only when an *authorized*
# device is removed — so unplugging a still-blocked device can't arm a window and
# get its replacement auto-allowed without a password.
_authorized_vidpid: set[str] = set()
_authorized_port: set[str] = set()

# Armed on REMOVAL of an authorized device; value is the removal timestamp.
_trust_window: dict[str, float] = {}       # vid_pid  -> removed_at
_port_trust_window: dict[str, float] = {}  # via_port -> removed_at

# Guards all of the state above plus _pending/_denied_until: it is shared
# between the GLib main loop (D-Bus callbacks) and authorization workers.
_state_lock = threading.Lock()

# At most one polkit dialog at a time. The agent can only service one
# conversation; concurrent pkexec calls fail instantly and feed pam_faillock.
_prompt_lock = threading.Lock()

# identity key -> newest blocked device id. Present while an authorization
# worker is running for that identity; re-inserts meanwhile just update the id.
_pending: dict[str, int] = {}

# identity key -> monotonic deadline until which prompts are suppressed.
_denied_until: dict[str, float] = {}


def get_env():
    env = os.environ.copy()
    for var in ('DISPLAY', 'XAUTHORITY', 'DBUS_SESSION_BUS_ADDRESS',
                'XDG_RUNTIME_DIR', 'KDE_FULL_SESSION'):
        val = os.environ.get(var)
        if val:
            env[var] = val
    return env


def run_polkit_helper(device_id: int, device_name: str) -> int | None:
    """Show the polkit dialog and run the helper. Returns the pkexec exit code,
    or None on timeout/error. 0 = authorized and allowed; 126/127 = the user
    dismissed the dialog or authentication was denied; any other code = the
    dialog succeeded but the helper itself failed (e.g. the device re-enumerated
    during the prompt and the id is stale)."""
    try:
        result = subprocess.run(
            [
                'pkexec',
                '--disable-internal-agent',
                HELPER_POLKIT,
                str(device_id)
            ],
            capture_output=True,
            text=True,
            timeout=60,
            env=get_env()
        )
        if result.returncode == 0:
            log.info('Device %d "%s" allowed via polkit', device_id, device_name)
        elif result.returncode in (126, 127):
            log.info('Device %d denied or cancelled (pkexec exit=%d)',
                     device_id, result.returncode)
        else:
            log.warning('Helper failed for device %d (pkexec exit=%d): %s',
                        device_id, result.returncode, result.stderr.strip())
        return result.returncode
    except subprocess.TimeoutExpired:
        log.warning('Polkit dialog timed out for device %d', device_id)
        return None
    except Exception as e:
        log.error('pkexec error: %s', e)
        return None


def allow_device_via_sudo(device_id: int, device_name: str) -> bool:
    """Fast path for devices already authorized in the trust window."""
    try:
        result = subprocess.run(
            ['sudo', '-n', HELPER_TRUSTED, str(device_id)],
            capture_output=True,
            text=True,
            timeout=10,
        )
        if result.returncode == 0:
            log.info('Device %d "%s" auto-allowed (trust window)', device_id, device_name)
            return True
        log.warning('Trusted helper failed for device %d (exit=%d): %s',
                    device_id, result.returncode, result.stderr.strip())
        return False
    except subprocess.TimeoutExpired:
        log.warning('Trusted helper timed out for device %d', device_id)
        return False
    except Exception as e:
        log.error('sudo helper-trusted error: %s', e)
        return False


def parse_device_name(device_rule: str) -> str:
    m = re.search(r'name\s+"([^"]+)"', str(device_rule))
    if m and m.group(1).strip():
        return m.group(1)
    m = re.search(r'\bid\s+([0-9a-fA-F]{4}:[0-9a-fA-F]{4})\b', str(device_rule))
    if m:
        return f'USB Device {m.group(1)}'
    return 'Unknown USB Device'


def parse_vid_pid(device_rule: str) -> str | None:
    m = re.search(r'\bid\s+([0-9a-fA-F]{4}:[0-9a-fA-F]{4})\b', str(device_rule))
    return m.group(1).lower() if m else None


def parse_via_port(device_rule: str) -> str | None:
    """Physical USB port path (e.g. '3-1.2'). Stable across re-enumeration on
    the same socket, even when the device changes VID:PID between modes."""
    m = re.search(r'\bvia-port\s+"([^"]+)"', str(device_rule))
    return m.group(1) if m else None


def is_recently_trusted(store: dict[str, float], key: str | None, window: float) -> bool:
    if key is None:
        return False
    ts = store.get(key)
    if ts is None:
        return False
    if time.monotonic() - ts > window:
        del store[key]
        return False
    return True


def mark_trusted(store: dict[str, float], key: str | None) -> None:
    if key is not None:
        store[key] = time.monotonic()


def mark_authorized(vid_pid: str | None, via_port: str | None) -> None:
    """Device is authorized and currently present: remember its identity and
    cancel any running remove-countdown (the grace clock only matters once the
    device is unplugged again). Caller must hold _state_lock."""
    if vid_pid is not None:
        _authorized_vidpid.add(vid_pid)
        _trust_window.pop(vid_pid, None)
    if via_port is not None:
        _authorized_port.add(via_port)
        _port_trust_window.pop(via_port, None)


def revoke_authorization(vid_pid: str | None, via_port: str | None) -> None:
    """The user explicitly denied this identity: forget any past authorization
    and disarm its windows. Without this, a device authorized earlier in the
    session but denied on re-insert would still arm a trust window on unplug —
    and the next replug would be auto-allowed, bypassing the explicit denial.
    Caller must hold _state_lock."""
    if vid_pid is not None:
        _authorized_vidpid.discard(vid_pid)
        _trust_window.pop(vid_pid, None)
    if via_port is not None:
        _authorized_port.discard(via_port)
        _port_trust_window.pop(via_port, None)


def identity_key(vid_pid: str | None, via_port: str | None, dev_id: int) -> str:
    """Stable identity for collapsing re-enumerations: VID:PID when known,
    otherwise the physical port, otherwise the (unique) device id."""
    if vid_pid is not None:
        return vid_pid
    if via_port is not None:
        return f'port:{via_port}'
    return f'dev:{dev_id}'


def authorize_worker(key: str, dev_id: int, device_name: str,
                     vid_pid: str | None, via_port: str | None,
                     trusted: bool, trust_reason: str) -> None:
    """Runs the (slow, possibly interactive) authorization outside the GLib
    main loop so USB events keep flowing while a dialog is open. Exactly one
    worker exists per identity key; re-inserts meanwhile only bump _pending."""
    try:
        if trusted:
            log.info('Blocked device id=%d name="%s" vid:pid=%s port=%s — within %s grace window',
                     dev_id, device_name, vid_pid, via_port, trust_reason)
            if allow_device_via_sudo(dev_id, device_name):
                with _state_lock:
                    mark_authorized(vid_pid, via_port)
                return
            log.info('Falling back to polkit prompt for device %d', dev_id)

        with _prompt_lock:
            # The device may have re-enumerated while we waited for the lock.
            with _state_lock:
                dev_id = _pending.get(key, dev_id)
            log.info('New blocked device: id=%d name="%s"', dev_id, device_name)
            rc = run_polkit_helper(dev_id, device_name)

        if rc == 0:
            with _state_lock:
                mark_authorized(vid_pid, via_port)
                latest = _pending.get(key, dev_id)
            if latest != dev_id:
                # Re-enumerated while the user was typing: the id we allowed is
                # stale. Auth already succeeded, so fix up the current
                # incarnation via the fast path.
                allow_device_via_sudo(latest, device_name)
        elif rc is None or rc in (126, 127):
            # Denied, cancelled or timed out: cool down this identity so a
            # re-enumerating device can't spam dialogs into a faillock lockout,
            # and revoke any trust it earned earlier in the session.
            with _state_lock:
                _denied_until[key] = time.monotonic() + DENIAL_COOLDOWN_SECONDS
                revoke_authorization(vid_pid, via_port)
            log.info('Device "%s" denied — suppressing prompts for %ds, trust revoked',
                     device_name, DENIAL_COOLDOWN_SECONDS)
        else:
            # Dialog completed but the helper failed — usually the id went
            # stale mid-prompt. If a newer incarnation exists, allow it.
            with _state_lock:
                latest = _pending.get(key, dev_id)
            if latest != dev_id and allow_device_via_sudo(latest, device_name):
                with _state_lock:
                    mark_authorized(vid_pid, via_port)
            else:
                log.warning('Device %d "%s" not allowed (helper failure)',
                            dev_id, device_name)
    finally:
        with _state_lock:
            _pending.pop(key, None)


def on_device_presence_changed(device_id, event_type, target, device_rule, *args):
    INSERT = 1
    REMOVE = 3
    BLOCK  = 1

    ev = int(event_type)
    vid_pid = parse_vid_pid(device_rule)
    via_port = parse_via_port(device_rule)

    # An authorized device was unplugged: start the grace clock now. The gap
    # until it re-appears (re-enumeration during flashing, or a deliberate
    # replug) is what we auto-allow. Only authorized devices arm a window.
    if ev == REMOVE:
        with _state_lock:
            if vid_pid in _authorized_vidpid:
                mark_trusted(_trust_window, vid_pid)
            if via_port in _authorized_port:
                mark_trusted(_port_trust_window, via_port)
        return

    if ev != INSERT:
        return
    if int(target) != BLOCK:
        return

    dev_id = int(device_id)
    device_name = parse_device_name(device_rule)
    key = identity_key(vid_pid, via_port, dev_id)

    with _state_lock:
        if key in _pending:
            # Same identity re-enumerated while its worker is still running:
            # remember the newest id, don't open another dialog.
            _pending[key] = dev_id
            log.info('Device id=%d "%s" re-enumerated during pending prompt — collapsed',
                     dev_id, device_name)
            return

        now = time.monotonic()
        deadline = _denied_until.get(key)
        if deadline is not None and now < deadline:
            log.info('Device id=%d "%s" was recently denied — staying blocked (%.0fs cooldown left)',
                     dev_id, device_name, deadline - now)
            return
        _denied_until.pop(key, None)

        trusted_vid  = is_recently_trusted(_trust_window, vid_pid, TRUST_WINDOW_SECONDS)
        trusted_port = is_recently_trusted(_port_trust_window, via_port, PORT_TRUST_WINDOW_SECONDS)
        _pending[key] = dev_id

    threading.Thread(
        target=authorize_worker,
        args=(key, dev_id, device_name, vid_pid, via_port,
              trusted_vid or trusted_port,
              'vid:pid' if trusted_vid else 'port'),
        daemon=True,
    ).start()


def main():
    log.info('Starting usb-auth-guard (polkit mode) for user %s', CURRENT_USER)

    dbus.mainloop.glib.DBusGMainLoop(set_as_default=True)

    try:
        bus = dbus.SystemBus()
        bus.get_name_owner('org.usbguard1')
    except dbus.DBusException as e:
        log.error('Cannot connect to USBGuard D-Bus: %s', e)
        log.error('Run: sudo systemctl start usbguard-dbus')
        sys.exit(1)

    state = {'iface': None, 'match': None}

    def subscribe():
        # Drop any stale signal match from a previous owner before adding a new
        # one. connect_to_signal() installs a match rule that survives the old
        # owner's disappearance; without removing it, rules accumulate on every
        # usbguard-dbus restart (and could double-fire depending on dbus-python).
        if state['match'] is not None:
            try:
                state['match'].remove()
            except Exception:
                pass
            state['match'] = None
        proxy = bus.get_object('org.usbguard1', '/org/usbguard1/Devices')
        iface = dbus.Interface(proxy, dbus_interface='org.usbguard.Devices1')
        state['match'] = iface.connect_to_signal(
            'DevicePresenceChanged', on_device_presence_changed)
        state['iface'] = iface
        log.info('Listening for USBGuard events...')

    try:
        subscribe()
    except dbus.DBusException as e:
        log.error('Cannot subscribe to USBGuard D-Bus signals: %s', e)
        sys.exit(1)

    # Re-subscribe automatically when usbguard-dbus restarts.
    # Each restart gives the process a new unique D-Bus name; without re-subscribing
    # the old match rule is stale and DevicePresenceChanged signals are never received.
    def on_usbguard_name_changed(new_owner):
        if new_owner and state['iface'] is None:
            log.info('USBGuard D-Bus reappeared, re-subscribing...')
            try:
                subscribe()
            except dbus.DBusException as e:
                log.error('Re-subscribe failed: %s', e)
        elif not new_owner and state['iface'] is not None:
            log.warning('USBGuard D-Bus disappeared, waiting for restart...')
            state['iface'] = None

    # watch_name_owner fires immediately with the current owner; because
    # subscribe() above already populated state['iface'], the
    # "new_owner and iface is None" branch is skipped for that initial call.
    bus.watch_name_owner('org.usbguard1', on_usbguard_name_changed)

    loop = GLib.MainLoop()
    try:
        loop.run()
    except KeyboardInterrupt:
        log.info('Stopped.')


if __name__ == '__main__':
    main()
