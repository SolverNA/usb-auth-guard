#!/usr/bin/env python3
"""
usb-auth-guard — USB device authorization daemon for KDE/Linux
Uses polkit (pkexec) for native KDE password dialog.

https://github.com/SolVerNA/usb-auth-guard
License: MIT
"""

import dbus
import dbus.mainloop.glib
from gi.repository import GLib
import subprocess
import os
import sys
import time
import logging
import re

logging.basicConfig(
    level=logging.INFO,
    format='[usb-auth-guard] %(levelname)s %(message)s'
)
log = logging.getLogger(__name__)

CURRENT_USER = os.environ.get('USER') or os.environ.get('LOGNAME', 'root')

HELPER_POLKIT  = '/usr/local/lib/usb-auth-guard/helper'
HELPER_TRUSTED = '/usr/local/lib/usb-auth-guard/helper-trusted'

# After successful polkit auth, re-enumerations of the same VID:PID within this
# window are auto-allowed via sudo NOPASSWD (no popup). Handles devices like
# iPhones that re-enumerate several times while switching USB modes.
TRUST_WINDOW_SECONDS = 60

# {vid_pid: last_authorized_timestamp}
_trust_window: dict[str, float] = {}


def get_env():
    env = os.environ.copy()
    for var in ('DISPLAY', 'XAUTHORITY', 'DBUS_SESSION_BUS_ADDRESS',
                'XDG_RUNTIME_DIR', 'KDE_FULL_SESSION'):
        val = os.environ.get(var)
        if val:
            env[var] = val
    return env


def allow_device_via_polkit(device_id: int, device_name: str) -> bool:
    try:
        result = subprocess.run(
            [
                'pkexec',
                '--disable-internal-agent',
                HELPER_POLKIT,
                str(device_id)
            ],
            capture_output=True,
            text=True,
            timeout=60,
            env=get_env()
        )
        if result.returncode == 0:
            log.info('Device %d "%s" allowed via polkit', device_id, device_name)
            return True
        else:
            log.info('Device %d denied or cancelled (pkexec exit=%d)',
                     device_id, result.returncode)
            return False
    except subprocess.TimeoutExpired:
        log.warning('Polkit dialog timed out for device %d', device_id)
        return False
    except Exception as e:
        log.error('pkexec error: %s', e)
        return False


def allow_device_via_sudo(device_id: int, device_name: str) -> bool:
    """Fast path for devices already authorized in the trust window."""
    try:
        result = subprocess.run(
            ['sudo', '-n', HELPER_TRUSTED, str(device_id)],
            capture_output=True,
            text=True,
            timeout=10,
        )
        if result.returncode == 0:
            log.info('Device %d "%s" auto-allowed (trust window)', device_id, device_name)
            return True
        log.warning('Trusted helper failed for device %d (exit=%d): %s',
                    device_id, result.returncode, result.stderr.strip())
        return False
    except subprocess.TimeoutExpired:
        log.warning('Trusted helper timed out for device %d', device_id)
        return False
    except Exception as e:
        log.error('sudo helper-trusted error: %s', e)
        return False


def parse_device_name(device_rule: str) -> str:
    m = re.search(r'name\s+"([^"]+)"', str(device_rule))
    if m and m.group(1).strip():
        return m.group(1)
    m = re.search(r'\bid\s+([0-9a-fA-F]{4}:[0-9a-fA-F]{4})\b', str(device_rule))
    if m:
        return f'USB Device {m.group(1)}'
    return 'Unknown USB Device'


def parse_vid_pid(device_rule: str) -> str | None:
    m = re.search(r'\bid\s+([0-9a-fA-F]{4}:[0-9a-fA-F]{4})\b', str(device_rule))
    return m.group(1).lower() if m else None


def is_recently_trusted(vid_pid: str) -> bool:
    ts = _trust_window.get(vid_pid)
    if ts is None:
        return False
    if time.monotonic() - ts > TRUST_WINDOW_SECONDS:
        del _trust_window[vid_pid]
        return False
    return True


def mark_trusted(vid_pid: str) -> None:
    _trust_window[vid_pid] = time.monotonic()


def on_device_presence_changed(device_id, event_type, target, device_rule, *args):
    INSERT = 1
    BLOCK  = 1

    if int(event_type) != INSERT:
        return
    if int(target) != BLOCK:
        return

    dev_id = int(device_id)
    device_name = parse_device_name(device_rule)
    vid_pid = parse_vid_pid(device_rule)

    if vid_pid and is_recently_trusted(vid_pid):
        log.info('Blocked device id=%d name="%s" vid:pid=%s — within trust window',
                 dev_id, device_name, vid_pid)
        if allow_device_via_sudo(dev_id, device_name):
            mark_trusted(vid_pid)  # refresh timestamp
            return
        log.info('Falling back to polkit prompt for device %d', dev_id)

    log.info('New blocked device: id=%d name="%s"', dev_id, device_name)
    if allow_device_via_polkit(dev_id, device_name) and vid_pid:
        mark_trusted(vid_pid)


def main():
    log.info('Starting usb-auth-guard (polkit mode) for user %s', CURRENT_USER)

    dbus.mainloop.glib.DBusGMainLoop(set_as_default=True)

    try:
        bus = dbus.SystemBus()
        bus.get_name_owner('org.usbguard1')
    except dbus.DBusException as e:
        log.error('Cannot connect to USBGuard D-Bus: %s', e)
        log.error('Run: sudo systemctl start usbguard-dbus')
        sys.exit(1)

    state = {'iface': None}

    def subscribe():
        proxy = bus.get_object('org.usbguard1', '/org/usbguard1/Devices')
        iface = dbus.Interface(proxy, dbus_interface='org.usbguard.Devices1')
        iface.connect_to_signal('DevicePresenceChanged', on_device_presence_changed)
        state['iface'] = iface
        log.info('Listening for USBGuard events...')

    try:
        subscribe()
    except dbus.DBusException as e:
        log.error('Cannot subscribe to USBGuard D-Bus signals: %s', e)
        sys.exit(1)

    # Re-subscribe automatically when usbguard-dbus restarts.
    # Each restart gives the process a new unique D-Bus name; without re-subscribing
    # the old match rule is stale and DevicePresenceChanged signals are never received.
    def on_usbguard_name_changed(new_owner):
        if new_owner and state['iface'] is None:
            log.info('USBGuard D-Bus reappeared, re-subscribing...')
            try:
                subscribe()
            except dbus.DBusException as e:
                log.error('Re-subscribe failed: %s', e)
        elif not new_owner and state['iface'] is not None:
            log.warning('USBGuard D-Bus disappeared, waiting for restart...')
            state['iface'] = None

    # watch_name_owner fires immediately with the current owner; because
    # subscribe() above already populated state['iface'], the
    # "new_owner and iface is None" branch is skipped for that initial call.
    bus.watch_name_owner('org.usbguard1', on_usbguard_name_changed)

    loop = GLib.MainLoop()
    try:
        loop.run()
    except KeyboardInterrupt:
        log.info('Stopped.')


if __name__ == '__main__':
    main()
