#!/bin/bash
set -e

case "$1" in
  remove|purge)
    # FIRST: Restore safe policies to prevent USB lockout
    CONF=/etc/usbguard/usbguard-daemon.conf
    if [ -f "$CONF" ]; then
        # Handle commented-out, existing, and missing keys.
        # InsertedDevicePolicy only supports: apply-policy | block | reject (not allow).
        # Set ImplicitPolicyTarget=allow so unmatched devices are permitted,
        # restoring pre-installation "allow everything" behaviour and avoiding lockout.
        sed -i 's|^#\?PresentDevicePolicy=.*|PresentDevicePolicy=allow|' "$CONF" || true
        sed -i 's|^#\?InsertedDevicePolicy=.*|InsertedDevicePolicy=apply-policy|' "$CONF" || true
        if grep -qE "^#?ImplicitPolicyTarget=" "$CONF"; then
            sed -i 's|^#\?ImplicitPolicyTarget=.*|ImplicitPolicyTarget=allow|' "$CONF" || true
        else
            echo "ImplicitPolicyTarget=allow" >> "$CONF"
        fi
    fi

    # Reload usbguard with safe policy (don't stop it)
    systemctl reload usbguard 2>/dev/null || \
        systemctl restart usbguard 2>/dev/null || true

    # Stop user service for all logged-in users
    for uid_dir in /run/user/*; do
        [ -d "$uid_dir" ] || continue
        uid=$(basename "$uid_dir")
        echo "$uid" | grep -qE '^[0-9]+$' || continue
        user=$(id -un "$uid" 2>/dev/null) || continue
        sudo -u "$user" XDG_RUNTIME_DIR="$uid_dir" \
            systemctl --user stop usb-auth-guard 2>/dev/null || true
        sudo -u "$user" XDG_RUNTIME_DIR="$uid_dir" \
            systemctl --user disable usb-auth-guard 2>/dev/null || true
    done

    # Remove user service symlinks
    for home_dir in /home/*; do
        [ -d "$home_dir" ] || continue
        rm -f "$home_dir/.config/systemd/user/default.target.wants/usb-auth-guard.service" 2>/dev/null || true
    done
    rm -f /root/.config/systemd/user/default.target.wants/usb-auth-guard.service 2>/dev/null || true

    # Remove sudoers entry (postinst may have rewritten it in place)
    rm -f /etc/sudoers.d/usb-auth-guard 2>/dev/null || true

    # Remove installation marker
    rm -f /var/lib/usb-auth-guard/.installed 2>/dev/null || true
    rm -rf /var/lib/usb-auth-guard 2>/dev/null || true
    ;;
esac

exit 0
