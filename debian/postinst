#!/bin/bash
set -e

INSTALL_MARKER="/var/lib/usb-auth-guard/.installed"
BACKUP_DIR="/var/lib/usb-auth-guard/backup"

case "$1" in
  configure)
    # Create directories
    mkdir -p "$BACKUP_DIR"

    # Create usbguard group if missing
    if ! getent group usbguard > /dev/null 2>&1; then
        groupadd --system usbguard
    fi

    # Set permissions on helper (must be root:root 755 for pkexec)
    chown root:root /usr/local/lib/usb-auth-guard/helper
    chmod 755 /usr/local/lib/usb-auth-guard/helper

    # helper-trusted is invoked via sudo NOPASSWD (trust-window fast path)
    if [ -f /usr/local/lib/usb-auth-guard/helper-trusted ]; then
        chown root:root /usr/local/lib/usb-auth-guard/helper-trusted
        chmod 755 /usr/local/lib/usb-auth-guard/helper-trusted
    fi

    # The sudoers file ships as a template with a {{USER}} placeholder.
    # Substitute the desktop user (first non-system account, uid >= 1000) and
    # validate with visudo. A file left containing {{USER}} would break sudo
    # entirely, so on any failure we remove it rather than ship a broken rule.
    SUDOERS=/etc/sudoers.d/usb-auth-guard
    if [ -f "$SUDOERS" ] && grep -q '{{USER}}' "$SUDOERS"; then
        DESKTOP_USER="${SUDO_USER:-}"
        if [ -z "$DESKTOP_USER" ] || [ "$DESKTOP_USER" = "root" ]; then
            DESKTOP_USER=$(getent passwd | awk -F: '$3 >= 1000 && $3 < 65534 {print $1; exit}')
        fi
        if [ -n "$DESKTOP_USER" ]; then
            TMP=$(mktemp)
            sed "s|{{USER}}|${DESKTOP_USER}|g" "$SUDOERS" > "$TMP"
            if visudo -c -f "$TMP" >/dev/null 2>&1; then
                install -Dm440 "$TMP" "$SUDOERS"
                echo "Installed sudoers entry for $DESKTOP_USER (trust-window fast path)"
            else
                echo "sudoers validation failed - removing (trust-window fast path disabled)"
                rm -f "$SUDOERS"
            fi
            rm -f "$TMP"
        else
            echo "Could not determine desktop user - removing sudoers template"
            rm -f "$SUDOERS"
        fi
    fi

    # Backup existing configs
    if [ -f /etc/usbguard/usbguard-daemon.conf ]; then
        cp /etc/usbguard/usbguard-daemon.conf "$BACKUP_DIR/" 2>/dev/null || true
    fi
    if [ -f /etc/usbguard/rules.conf ]; then
        cp /etc/usbguard/rules.conf "$BACKUP_DIR/" 2>/dev/null || true
    fi

    # Generate rules for currently connected devices if rules.conf is empty
    if [ ! -s /etc/usbguard/rules.conf ]; then
        echo "Generating USBGuard rules for currently connected devices..."
        usbguard generate-policy > /etc/usbguard/rules.conf 2>/dev/null || true
    fi

    # Configure usbguard policy (AFTER rules are in place)
    CONF=/etc/usbguard/usbguard-daemon.conf
    if [ -f "$CONF" ]; then
        # Handle commented-out, existing, and missing keys.
        if grep -qE "^#?PresentDevicePolicy=" "$CONF"; then
            sed -i 's|^#\?PresentDevicePolicy=.*|PresentDevicePolicy=apply-policy|' "$CONF" || true
        else
            echo "PresentDevicePolicy=apply-policy" >> "$CONF"
        fi
        if grep -qE "^#?InsertedDevicePolicy=" "$CONF"; then
            sed -i 's|^#\?InsertedDevicePolicy=.*|InsertedDevicePolicy=block|' "$CONF" || true
        else
            echo "InsertedDevicePolicy=block" >> "$CONF"
        fi
    fi

    # Enable and start system services
    systemctl daemon-reload
    systemctl enable usbguard usbguard-dbus 2>/dev/null || true
    systemctl restart usbguard usbguard-dbus 2>/dev/null || true

    # Mark installation complete
    date '+%Y-%m-%d %H:%M:%S' > "$INSTALL_MARKER"

    # User instructions
    echo ""
    echo "usb-auth-guard installed successfully!"
    echo ""
    echo "Enable for your user:"
    echo "  systemctl --user enable --now usb-auth-guard"
    echo ""
    echo "Or log out and log back in for automatic start."
    echo ""
    ;;
esac

exit 0
